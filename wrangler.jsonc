{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raider-arena",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-07-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ArenaRoom" },
      { "name": "AUTH", "class_name": "AuthGuard" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArenaRoom", "AuthGuard"] },
  ],
}
