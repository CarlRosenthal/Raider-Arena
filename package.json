{
  "name": "raider-arena",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/build.cjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run build && node --test tests/worker.test.mjs && node tests/logic.cjs",
    "test:remote": "node tests/remote.cjs",
    "check:deploy": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.9",
    "jsdom": "30.1.1",
    "miniflare": "4.20260730.0",
    "playwright": "1.58.2",
    "wrangler": "4.145.0"
  }
}
